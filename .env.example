# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=tu_password_mysql
DB_NAME=colegio_db

# ==========================================
# CONFIGURACIÓN JWT
# ==========================================
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui
JWT_EXPIRES_IN=1h
JWT_RESET_EXPIRES_IN=1h

# ==========================================
# CONFIGURACIÓN DE EMAIL (BREVO)
# ==========================================
BREVO_API_KEY=tu_brevo_api_key
BREVO_FROM_EMAIL=noreply@colegio.com
BREVO_FROM_NAME=Nombre del Colegio

# ==========================================
# CONFIGURACIÓN DE EMAIL (RESEND)
# ==========================================
RESEND_API_KEY=tu_resend_api_key

# ==========================================
# CONFIGURACIÓN DE TELEGRAM
# ==========================================
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token

# ==========================================
# CONFIGURACIÓN DE URLS
# ==========================================
FRONTEND_URL=http://localhost:4200
BASE_URL=http://localhost:3000

# ==========================================
# CONFIGURACIÓN DE ENTORNO
# ==========================================
NODE_ENV=development

# ==========================================
# CONFIGURACIÓN DE ADMINISTRADOR POR DEFECTO
# ==========================================
ADMIN_DEFAULT_PASSWORD=tu_password_admin_seguro
HTTPS_ENABLED=false
